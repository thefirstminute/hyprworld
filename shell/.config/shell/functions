# FZF font selector (copies name to clipboard on Enter)
# fontSnatch() {
  # fc-list : family | cut -d, -f1 | sort -u | fzf --preview "echo {}" | xclip -sel clip
# }
fontSnatch() {
    local TEXT="ABCDEFGHIJKLM\nnopqrstuvwxyz\n0123456789\nSlashed 0: 0 vs O\n󰖩 󰂯 󰕾 "
    local TMP_IMG='/tmp/preview_font.png'
    trap "kitty +kitten icat --clear --stdin=no > /dev/tty" EXIT

    fc-list : file family | sort -u | fzf \
        --preview-window=right:60% \
        --preview "
            FONT_PATH=\$(echo {} | cut -d: -f1)

            # Use 'caption' for automatic word-wrapping
            magick -size 600x400 -background '#1e1e2e' -fill '#f8f8f2' \
                   -font \"\$FONT_PATH\" -pointsize 30 \
                   -gravity center caption:\"$TEXT\" \"$TMP_IMG\"

            # Send to TTY directly
            kitty +kitten icat --transfer-mode=file --stdin=no --place 50x30@60x5 \"$TMP_IMG\" > /dev/tty
        " \
        --bind "enter:execute-silent(echo -n {} | cut -d: -f2- | xargs echo -n | xclip -sel clip)+abort"
}

# # Use neovim
if command -v nvim &> /dev/null; then
  nv() {
    items=("default")
    items+=("nude")

    # Get all nvim config directory names, exclude hidden files:
    # NOT full path, just name.
    for d in "$HOME/.config/.neovims"/*/; do
      [[ -d "$d" ]] || continue
      ### exclude hidden files
      [[ $(basename "$d") == .* ]] && continue
        items+=("$(basename "$d")")
    done

    count=${#items[@]}
    height=$((count + 16))

    config=$(printf '%s\n' "${items[@]}" | fzf \
      --prompt=" Neovim Config  " \
      --border \
      --border-label=" NVIM CONFIGS " \
      --border-label-pos=top \
      --height="$height" \
      --margin=2,5 \
      --padding=2 \
      --no-multi \
      --smart-case \
      --no-preview \
      --layout=reverse \
      --exit-0)

    [[ -z $config ]] && echo "Nothing selected" && return 0

    if [[ $config == "default" ]]; then
      NVIM_APPNAME="" nvim "$@"
    elif [[ $config == "nude" ]]; then
      nvim -u NONE -U NONE --noplugin "$@"
    else
      NVIM_APPNAME=".neovims/$config" nvim "$@"
    fi
  }
fi


